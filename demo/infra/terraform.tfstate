{
  "version": 4,
  "terraform_version": "1.5.0",
  "serial": 1,
  "lineage": "golden-demo-lineage-001",
  "resources": [
    {
      "mode": "managed",
      "type": "aws_security_group",
      "name": "web_sg",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "id": "sg-demo-web",
            "arn": "arn:aws:ec2:us-east-1:123456789012:security_group/sg-demo-web",
            "name": "web-prod-sg",
            "description": "Production web security group",
            "vpc_id": "vpc-0123456789abcdef0",
            "ingress": [
              {
                "protocol": "tcp",
                "from_port": 443,
                "to_port": 443,
                "cidr_blocks": ["0.0.0.0/0"]
              }
            ],
            "egress": [
              {
                "protocol": "-1",
                "from_port": 0,
                "to_port": 0,
                "cidr_blocks": ["0.0.0.0/0"]
              }
            ],
            "tags": {
              "Environment": "production",
              "Owner": "devops-team",
              "CostCenter": "cc-900"
            }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "prod_assets",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "id": "prod-assets-corp-bucket-12345",
            "bucket": "prod-assets-corp-bucket-12345",
            "arn": "arn:aws:s3:::prod-assets-corp-bucket-12345",
            "public_access_block_enabled": true,
            "tags": {
              "Environment": "production",
              "Owner": "devops-team",
              "CostCenter": "cc-900"
            }
          }
        }
      ]
    }
  ]
}
